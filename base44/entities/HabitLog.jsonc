    },
    "habit_id": {
      "type": "string"
    },
    "habit_title": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "log_date": {
      "type": "string"
    },
    "completed": {
      "type": "boolean",
      "default": false
    },
    "note": {
      "type": "string"
    }
