{
  "name": "UserProfile",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string"
    },
    "age": {
      "type": "number"
    },
    "gender": {
      "type": "string"
    },
    "timezone": {
      "type": "string"
    },
    "goal_categories": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "primary_focus": {
      "type": "string"
    },
    "current_lifestyle_summary": {
      "type": "string"
    },
    "biggest_challenge": {
      "type": "string"
    },
    "future_self_statement": {
      "type": "string"
    },
    "subscription_tier": {
      "type": "string",
      "enum": [
        "free",
        "supporter",
        "premium"
      ],
      "default": "free"
    },
    "billing_cycle": {
      "type": "string",
      "enum": [
        "monthly",
        "annual"
      ],
      "default": "monthly"
    },
    "billing_platform": {
      "type": "string",
      "enum": [
        "stripe",
        "apple",
        "google",
        "manual",
        "none"
      ],
      "default": "none"
    },
    "stripe_customer_id": {
      "type": "string"
    },
    "stripe_subscription_id": {
      "type": "string"
    },
    "renewal_date": {
      "type": "string"
    },
    "trial_ends_at": {
      "type": "string"
    },
    "ai_credits": {
      "type": "number",
      "default": 0
    },
    "ai_credits_used_this_month": {
      "type": "number",
      "default": 0
    },
    "onboarding_completed": {
      "type": "boolean",
      "default": false
    },
    "notifications_enabled": {
      "type": "boolean",
      "default": true
    },
    "notifications_permission_asked": {
      "type": "boolean",
      "default": false
    },
    "morning_intention_enabled": {
      "type": "boolean",
      "default": false
    },
    "morning_intention_time": {
      "type": "string",
      "default": "07:00"
    },
    "midday_alignment_enabled": {
      "type": "boolean",
      "default": false
    },
    "midday_alignment_time": {
      "type": "string",
      "default": "12:00"
    },
    "evening_reflection_enabled": {
      "type": "boolean",
      "default": false
    },
    "evening_reflection_time": {
      "type": "string",
      "default": "20:00"
    },
    "morning_emotion_enabled": {
      "type": "boolean",
      "default": false
    },
    "morning_emotion_time": {
      "type": "string",
      "default": "07:30"
    },
    "evening_emotion_enabled": {
      "type": "boolean",
      "default": false
    },
    "evening_emotion_time": {
      "type": "string",
      "default": "20:30"
    },
    "streak_count": {
      "type": "number",
      "default": 0
    },
    "last_checkin_date": {
      "type": "string"
    },
    "alignment_points": {
      "type": "number",
      "default": 0
    },
    "identity_level": {
      "type": "number",
      "default": 0
    },
    "total_habits_completed": {
      "type": "number",
      "default": 0
    },
    "total_checkins": {
      "type": "number",
      "default": 0
    },
    "total_journal_entries": {
      "type": "number",
      "default": 0
    },
    "score_improvements": {
      "type": "number",
      "default": 0
    },
    "earned_badge_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "last_points_awarded_date": {
      "type": "string"
    }
  },
  "required": []
}