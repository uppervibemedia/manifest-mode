{
  "name": "UserProfile",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string"
    },
    "age": {
      "type": "number"
    },
    "gender": {
      "type": "string"
    },
    "timezone": {
      "type": "string"
    },
    "goal_categories": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "primary_focus": {
      "type": "string"
    },
    "current_lifestyle_summary": {
      "type": "string"
    },
    "biggest_challenge": {
      "type": "string"
    },
    "future_self_statement": {
      "type": "string"
    },
    "subscription_tier": {
      "type": "string",
      "enum": [
        "free",
        "supporter",
        "premium"
      ],
      "default": "free"
    },
    "onboarding_completed": {
      "type": "boolean",
      "default": false
    },
    "notifications_enabled": {
      "type": "boolean",
      "default": true
    },
    "streak_count": {
      "type": "number",
      "default": 0
    },
    "last_checkin_date": {
      "type": "string"
    },
    "alignment_points": {
      "type": "number",
      "default": 0
    },
    "identity_level": {
      "type": "number",
      "default": 0
    },
    "total_habits_completed": {
      "type": "number",
      "default": 0
    },
    "total_checkins": {
      "type": "number",
      "default": 0
    },
    "total_journal_entries": {
      "type": "number",
      "default": 0
    },
    "score_improvements": {
      "type": "number",
      "default": 0
    },
    "earned_badge_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "last_points_awarded_date": {
      "type": "string"
    }
  },
  "required": []
}