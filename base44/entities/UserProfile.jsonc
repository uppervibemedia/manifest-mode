{
  "name": "UserProfile",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string"
    },
    "age": {
      "type": "number"
    },
    "gender": {
      "type": "string"
    },
    "timezone": {
      "type": "string"
    },
    "goal_categories": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "primary_focus": {
      "type": "string"
    },
    "current_lifestyle_summary": {
      "type": "string"
    },
    "biggest_challenge": {
      "type": "string"
    },
    "future_self_statement": {
      "type": "string"
    },
    "subscription_tier": {
      "type": "string",
      "enum": [
        "free",
        "supporter",
        "premium"
      ],
      "default": "free",
      "rls": {
        "read": true,
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "billing_cycle": {
      "type": "string",
      "enum": [
        "monthly",
        "annual"
      ],
      "default": "monthly",
      "rls": {
        "read": true,
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "billing_platform": {
      "type": "string",
      "enum": [
        "stripe",
        "apple",
        "google",
        "manual",
        "none"
      ],
      "default": "none",
      "rls": {
        "read": true,
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "stripe_customer_id": {
      "type": "string",
      "rls": {
        "read": true,
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "stripe_subscription_id": {
      "type": "string",
      "rls": {
        "read": true,
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "renewal_date": {
      "type": "string",
      "rls": {
        "read": true,
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "trial_ends_at": {
      "type": "string",
      "rls": {
        "read": true,
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "ai_credits": {
      "type": "number",
      "default": 0
    },
    "ai_credits_used_this_month": {
      "type": "number",
      "default": 0
    },
    "onboarding_completed": {
      "type": "boolean",
      "default": false
    },
    "notifications_enabled": {
      "type": "boolean",
      "default": true
    },
    "notifications_permission_asked": {
      "type": "boolean",
      "default": false
    },
    "morning_intention_enabled": {
      "type": "boolean",
      "default": false
    },
    "morning_intention_time": {
      "type": "string",
      "default": "07:00"
    },
    "midday_alignment_enabled": {
      "type": "boolean",
      "default": false
    },
    "midday_alignment_time": {
      "type": "string",
      "default": "12:00"
    },
    "evening_reflection_enabled": {
      "type": "boolean",
      "default": false
    },
    "evening_reflection_time": {
      "type": "string",
      "default": "20:00"
    },
    "morning_emotion_enabled": {
      "type": "boolean",
      "default": false
    },
    "morning_emotion_time": {
      "type": "string",
      "default": "07:30"
    },
    "evening_emotion_enabled": {
      "type": "boolean",
      "default": false
    },
    "evening_emotion_time": {
      "type": "string",
      "default": "20:30"
    },
    "streak_count": {
      "type": "number",
      "default": 0
    },
    "last_checkin_date": {
      "type": "string"
    },
    "alignment_points": {
      "type": "number",
      "default": 0
    },
    "identity_level": {
      "type": "number",
      "default": 0
    },
    "total_habits_completed": {
      "type": "number",
      "default": 0
    },
    "total_checkins": {
      "type": "number",
      "default": 0
    },
    "total_journal_entries": {
      "type": "number",
      "default": 0
    },
    "score_improvements": {
      "type": "number",
      "default": 0
    },
    "earned_badge_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "last_points_awarded_date": {
      "type": "string"
    }
  },
  "required": [],
  "rls": {
    "create": {
      "$and": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "user"
              }
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
